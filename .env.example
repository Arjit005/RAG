# Core API Keys (Multi-Provider Model Router)
GROQ_API_KEY=your_groq_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here

# JWT Authentication
JWT_SECRET=your_super_secret_jwt_key_min_32_chars_here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration (Neon PostgreSQL in us-east-2 / Ohio)
# Runtime Application URL (Pooled connection via PgBouncer for high concurrency)
DATABASE_URL=postgresql://user:password@ep-lucky-scene-bd4u2eh5-pooler.c-8.us-east-2.aws.neon.tech/neondb?sslmode=require

# Qdrant Vector Database
# Set QDRANT_URL and QDRANT_API_KEY for Qdrant Cloud in production
QDRANT_URL=https://your-cluster-id.us-east-1.aws.cloud.qdrant.io:6333
QDRANT_API_KEY=your_qdrant_cloud_api_key
QDRANT_COLLECTION=rag_enterprise_chunks
# Or for local disk storage (ephemeral on cloud instances without persistent disk):
# QDRANT_LOCATION=qdrant_storage

# Storage Selection ('qdrant' for production, 'faiss' for fallback)
VECTOR_STORE_TYPE=qdrant

# Embedding & LLM
EMBEDDING_MODEL=all-MiniLM-L6-v2
DEFAULT_LLM_MODEL=qwen/qwen3.8-27b

# Frontend Service URL (for CORS)
FRONTEND_URL=https://rag-frontend.onrender.com
NEXT_PUBLIC_API_URL=https://rag-backend.onrender.com
